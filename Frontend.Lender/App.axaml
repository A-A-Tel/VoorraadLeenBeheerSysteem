<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FrontendLender.App"
             xmlns:local="using:FrontendLender"
             RequestedThemeVariant="Light">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <Styles>
            <!-- Hier kun je globale styles zetten -->
            <Style Selector="TextBox.NoFocusBackground">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Style>
        </Styles>
    </Application.Styles>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <SolidColorBrush x:Key="Accent">#FCCA60</SolidColorBrush>
        <SolidColorBrush x:Key="ActionBad">#BA0005</SolidColorBrush>
        <SolidColorBrush x:Key="ActionGood">#11D611</SolidColorBrush>
        <SolidColorBrush x:Key="ActionNeutral">#EB8100</SolidColorBrush>
        <SolidColorBrush x:Key="Background">#6250A3</SolidColorBrush>
        <SolidColorBrush x:Key="Divider">#8A8787</SolidColorBrush>
        <SolidColorBrush x:Key="Primary">#6E6EB5</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryDark">#2B2B5C</SolidColorBrush>
        <SolidColorBrush x:Key="PrimaryLight">#C8C8FA</SolidColorBrush>
        <SolidColorBrush x:Key="Secondary">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="TextPrimary">#000000</SolidColorBrush>
        <SolidColorBrush x:Key="TextSecondary">#FFFFFF</SolidColorBrush>
    </Application.Resources>

</Application>