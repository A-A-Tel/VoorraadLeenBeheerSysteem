<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dashboard="clr-namespace:FrontendLender.ViewModels.Dashboard"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="{x:Type dashboard:DashboardPageViewModel}"
             x:Class="FrontendLender.Views.Dashboard.DashboardPageView">
    <TextBlock Text="{Binding JwtToken}"></TextBlock>
</UserControl>
