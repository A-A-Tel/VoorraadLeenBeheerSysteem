@startuml
!pragma layout elk

package Backend {

    package App {

        package Global {

            interface IPasswordService {
                + HashPassword(password: string, user: User?): string
                + VerifyPassword(user: User, hashedPassword: string, providedPassword: string): PasswordVerificationResult
            }
            Backend.App.Global.IPasswordService <|-down- Backend.App.Global.PasswordService
            class PasswordService {
                - _passwordHasher: PasswordHasher<User>
            }

        }

        package Interceptors {

            abstract Interceptor <<Grpc.Core.Interceptors>>

            class GrpcExceptionInterceptor {
                + UnaryServerHandler<TRequest, TResponse>(...): Task<TResponse> <<override>>
            }
            Backend.App.Interceptors.Interceptor <|-down- Backend.App.Interceptors.GrpcExceptionInterceptor

        }

        package Logic {

            package AuthLogic {

                interface IAuthRepository {
                    + GetUserAsync(cardBytes: byte[]): Task<User?>
                    + GetUserAsync(email: string): Task<User?>
                    + RehashPasswordAsync(user: User, password: string): Task
                }
                Backend.App.Logic.AuthLogic.IAuthRepository <|-down- Backend.App.Logic.AuthLogic.AuthRepository
                class AuthRepository {
                    - database: AppDbContext
                    - passwordService: IPasswordService
                }

                interface IAuthService {
                    + GetLenderName(LenderLookupRequest request): Task<LenderLookupResponse>
                    + LoginAsync(request: LenderLoginRequest): Task<LoginResponse>
                    + LoginAsync(request: ManagerLoginRequest): Task<LoginResponse>
                }
                Backend.App.Logic.AuthLogic.IAuthService <|-down- Backend.App.Logic.AuthLogic.AuthService
                class AuthService {
                    - repository: IAuthRepository
                    - configuration: IConfiguration
                    - passwordService: IPasswordService

                    - GenerateJwtToken(userId: string, username: string, role: RoleType): string
                }

                abstract AuthControllerBase <<Protos.Auth.AuthController>>
                Backend.App.Logic.AuthLogic.AuthControllerBase <|-down- Backend.App.Logic.AuthLogic.AuthController
                class AuthController {
                    + ManagerLogin(request: ManagerLoginRequest, context: ServerCallContext): Task<LoginResponse> <<override>>
                }

                Backend.App.Logic.AuthLogic.IAuthRepository <|.. Backend.App.Logic.AuthLogic.AuthService
                Backend.App.Logic.AuthLogic.IAuthService <|.. Backend.App.Logic.AuthLogic.AuthController
            }

            package LoanLogic {

                interface ILoanRepository {

                }
                Backend.App.Logic.LoanLogic.ILoanRepository <|-down- Backend.App.Logic.LoanLogic.LoanRepository
                class LoanRepository {

                }

                interface ILoanService {

                }
                Backend.App.Logic.LoanLogic.ILoanService <|-down- Backend.App.Logic.LoanLogic.LoanService
                class LoanService {

                }

                abstract LoanControllerBase <<Protos.Loan.LoanController>>
                Backend.App.Logic.LoanLogic.LoanControllerBase <|-down- Backend.App.Logic.LoanLogic.LoanController
                class LoanController {

                }

                Backend.App.Logic.LoanLogic.ILoanRepository <|.. Backend.App.Logic.LoanLogic.LoanService
                Backend.App.Logic.LoanLogic.ILoanService <|.. Backend.App.Logic.LoanLogic.LoanController

            }

            package ProductLogic {

                interface IProductRepository {

                }
                Backend.App.Logic.ProductLogic.IProductRepository <|-down- Backend.App.Logic.ProductLogic.ProductRepository
                class ProductRepository {

                }

                interface IProductService {

                }
                Backend.App.Logic.ProductLogic.IProductService <|-down- Backend.App.Logic.ProductLogic.ProductService
                class ProductService {

                }

                abstract ProductControllerBase <<Protos.Product.ProductController>>
                Backend.App.Logic.ProductLogic.ProductControllerBase <|-down- Backend.App.Logic.ProductLogic.ProductController
                class ProductController {

                }

                Backend.App.Logic.ProductLogic.IProductRepository <|.. Backend.App.Logic.ProductLogic.ProductService
                Backend.App.Logic.ProductLogic.IProductService <|.. Backend.App.Logic.ProductLogic.ProductController

            }

            package UserLogic {

                interface IUserRepository {

                }
                Backend.App.Logic.UserLogic.IUserRepository <|-down- Backend.App.Logic.UserLogic.UserRepository
                class UserRepository {

                }

                interface IUserService {

                }
                Backend.App.Logic.UserLogic.IUserService <|-down- Backend.App.Logic.UserLogic.UserService
                class UserService {

                }

                abstract UserControllerBase <<Protos.User.UserController>>
                Backend.App.Logic.UserLogic.UserControllerBase <|-down- Backend.App.Logic.UserLogic.UserController
                class UserController {

                }

                Backend.App.Logic.UserLogic.IUserRepository <|.. Backend.App.Logic.UserLogic.UserService
                Backend.App.Logic.UserLogic.IUserService <|.. Backend.App.Logic.UserLogic.UserController
            }

        }

    }

}

Backend.App.Global -[hidden]down- Backend.App.Interceptors
Backend.App.Interceptors -[hidden]down- Backend.App.Logic

Backend.App.Logic.AuthLogic -[hidden]down- Backend.App.Logic.LoanLogic
Backend.App.Logic.LoanLogic -[hidden]down- Backend.App.Logic.ProductLogic
Backend.App.Logic.ProductLogic -[hidden]down- Backend.App.Logic.UserLogic

@enduml